# ClickUp API keys for source workspaces (comma-separated)
SOURCE_KEYS=pk_source1,pk_source2
SOURCE_TEAM_IDS=team_id_1,team_id_2

# ClickUp API key for destination workspace
DEST_KEY=pk_dest
DEST_TEAM_ID=team_id_dest

# Custom field IDs used to track source task/list references
CUSTOM_FIELD_SOURCE_TASK_ID=uuid-of-custom-field
CUSTOM_FIELD_SOURCE_LIST_ID=uuid-of-custom-field

# Sync interval in milliseconds (default: 300000 = 5 min)
# SYNC_INTERVAL_MS=300000

# SQLite database path (default: ./data/sync.db)
# DB_PATH=./data/sync.db
